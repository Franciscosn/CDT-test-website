---
// Home page. The markup lives in src/components/home.html, styles in public/css/home.css,
// the animation (neutron events, image changer, cursor) in public/js/home.js.
import home from '../components/home.html?raw';
import { getCollection } from 'astro:content';

// The three newest lab log entries replace the <!--LABLOG--> marker in home.html.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const entries = (await getCollection('lablog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const mono = 'font-family: &quot;IBM Plex Mono&quot;, monospace;';
const items = entries.map((e, i) => {
  const d = e.data.date.toISOString().slice(0, 7);
  const sep = i < entries.length - 1 ? ' border-right: 1px solid rgba(20, 20, 28, 0.15);' : '';
  const href = e.data.link ? esc(e.data.link) : '#';
  return `<a class="log" href="${href}" style="flex: 1 1 0%;${sep}"><span class="ldate" style="${mono} font-size: 11.5px; color: rgb(128, 0, 0);">${d} · ${esc(e.data.category.toUpperCase())}</span><span class="lt" style="font-size: 14.5px; line-height: 1.35;">${esc(e.data.title)}</span></a>`;
}).join('');
const lablog = `<section class="lab" aria-label="Lab log" style="flex: 0 0 auto; display: flex; align-items: stretch; padding: 11px 44px; border-top: 1px solid rgb(20, 20, 28); background: rgb(255, 255, 255);"><a href="#" style="flex: 0 0 auto; display: flex; flex-direction: column; justify-content: center; gap: 2px; padding-right: 22px; border-right: 2px solid rgb(0, 0, 255);"><span class="llab" style="${mono} font-size: 12px; letter-spacing: 2px; color: rgb(0, 0, 255);">LAB LOG</span><span class="lall" style="${mono} font-size: 11px; color: rgb(95, 94, 104);">all entries →</span></a><div class="logs" style="flex: 1 1 0%; display: flex;">${items}</div></section>`;
const page = home.replace('<!--LABLOG-->', lablog);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CDT CASCADE Detector Technologies GmbH</title>
    <meta name="description" content="Neutron instrumentation since 2006: detectors, readout electronics and software for neutron science. Made in Heidelberg, Germany." />
    <link rel="icon" type="image/png" href="img/ef363c21761d6c2b0566f4c045857194.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Electrolize&family=Jura:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;700&family=Carlito:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="css/home.css" />
  </head>
  <body>
    <Fragment set:html={page} />
    <script is:inline src="js/products.js"></script>
    <script is:inline src="js/home.js"></script>
  </body>
</html>
