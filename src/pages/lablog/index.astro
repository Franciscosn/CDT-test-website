---
// Lab log overview: big title with round filter chips on top, entries as a measurement log below, newest first.
import Page from '../../layouts/Page.astro';
import { getCollection } from 'astro:content';
import { url, asset, teaser, ymd } from '../../lib/chrome';

const entries = (await getCollection('lablog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const cats = [...new Set(entries.map((e) => e.data.category.toUpperCase()))];
const count = (c: string) => entries.filter((e) => e.data.category.toUpperCase() === c).length;
---
<Page title="Lab log · CDT CASCADE Detector Technologies" description="Talks, deliveries and milestones from CDT in Heidelberg, Germany." active="lablog">
  <section class="ltop">
    <h1>Lab log<span>Talks, deliveries and milestones from Heidelberg, Germany.</span></h1>
    <div class="lfilter" role="group" aria-label="Filter by category">
      <button type="button" class="lchip on" data-f="*" aria-pressed="true">ALL<span>{entries.length}</span></button>
      {cats.map((c) => <button type="button" class="lchip" data-f={c} aria-pressed="false">{c}<span>{count(c)}</span></button>)}
    </div>
  </section>

  <section class="llog" aria-label="Entries">
    {entries.map((e) => {
      const href = url(`lablog/${e.slug}/`);
      const t = teaser(e.body);
      return (
        <article class={e.data.image ? 'lrow' : 'lrow lrow-noimg'} data-cat={e.data.category.toUpperCase()}>
          <div class="ld"><b>{ymd(e.data.date)}</b><span>{e.data.category.toUpperCase()}</span></div>
          <div class="lt">
            <h2><a href={href}>{e.data.title}</a></h2>
            {t && <p>{t}</p>}
            <a class="lread" href={href} tabindex="-1">→ Read entry</a>
          </div>
          {e.data.image && (
            <a class="kframe lthumb" href={href} tabindex="-1" aria-hidden="true"><img src={asset(e.data.image)} alt="" loading="lazy" /></a>
          )}
        </article>
      );
    })}
    {entries.length === 0 && <p class="lempty">No entries yet.</p>}
  </section>

  <script is:inline>
    (function () {
      var chips = document.querySelectorAll('.lchip'), rows = document.querySelectorAll('.lrow');
      chips.forEach(function (c) {
        c.addEventListener('click', function () {
          var f = c.getAttribute('data-f');
          chips.forEach(function (x) { x.classList.toggle('on', x === c); x.setAttribute('aria-pressed', x === c ? 'true' : 'false'); });
          rows.forEach(function (r) { r.hidden = !(f === '*' || r.getAttribute('data-cat') === f); });
        });
      });
    })();
  </script>
</Page>
